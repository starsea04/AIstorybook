{
  "name": "storybook-studio-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-page-flip.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "test:reader": "node --experimental-strip-types --test scripts/reader-playback.test.mjs",
    "test:editor": "node --experimental-strip-types --test scripts/editor-pages.test.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.9",
    "echarts": "6.1.0",
    "element-plus": "^2.9.1",
    "page-flip": "2.0.7",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.2",
    "vite": "~5.4.14",
    "vue-tsc": "^2.2.0"
  }
}
